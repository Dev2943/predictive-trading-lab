# Deployment configuration. Copy to .env and fill in.
# NEVER commit a filled-in copy: the secrets below grant market data access.

# --- backend ---------------------------------------------------------------
# development | production. Production refuses debug mode, localhost origins
# and a wildcard CORS policy.
PTL_ENV=development
PTL_HOST=0.0.0.0
PORT=8000
PTL_LOG_LEVEL=info
PTL_DEBUG=

# Comma separated. In production this must be your deployed frontend origin;
# the settings validator rejects localhost and "*".
PTL_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Where session state is persisted. On a platform without an attached disk this
# is ephemeral and sessions do not survive a restart.
PTL_RESULTS=results
PTL_CONFIG=config/base.toml

# --- market data -----------------------------------------------------------
# replay | alpaca. `alpaca` requires both credentials below and will refuse to
# start without them rather than silently falling back to synthetic data.
PTL_MARKET_PROVIDER=replay
PTL_ALPACA_KEY=
PTL_ALPACA_SECRET=

# --- build metadata (optional, set by CI) ----------------------------------
PTL_COMMIT=
PTL_BUILT_AT=

# --- frontend --------------------------------------------------------------
# Baked into the bundle at BUILD time, not read at runtime. Changing it
# requires a rebuild/redeploy.
NEXT_PUBLIC_API_BASE=http://localhost:8000
